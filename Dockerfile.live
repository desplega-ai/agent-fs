# agent-fs live UI (live/) served by nginx

FROM --platform=$BUILDPLATFORM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS builder

WORKDIR /repo
# vite.config.ts reads the root package.json for the app version.
COPY package.json ./
COPY live/ ./live/

WORKDIR /repo/live
# Off by default for self-hosted images; pass --build-arg VITE_ANONYMIZED_TELEMETRY=true to send it.
ARG VITE_ANONYMIZED_TELEMETRY=false
RUN corepack enable && pnpm install --frozen-lockfile && pnpm run build

FROM nginxinc/nginx-unprivileged:1.29.8-alpine@sha256:0c79d56aee561a1d81c63f00eee5fb5fe29279560cdc55e91425133104c7fbe6

COPY live/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/live/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO /dev/null http://127.0.0.1:8080/healthz || exit 1
