# agent-fs environment variables
# Copy to .env and fill in your values

# ── Core ──────────────────────────────────────────────
# Override default config directory (~/.agent-fs)
# AGENT_FS_HOME=~/.agent-fs

# ── Remote API (when connecting to a hosted agent-fs server) ──
# AGENT_FS_API_URL=https://your-server.example.com
# AGENT_FS_API_KEY=af_your_api_key_here

# ── Web App URL (enables appUrl field in op responses) ──
# AGENT_FS_APP_URL=https://live.agent-fs.dev

# ── S3 Storage ────────────────────────────────────────
# Generic S3 env vars (work with any S3-compatible provider)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=AKIA...
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_REGION=us-east-1
# S3_PROVIDER=minio

# Tigris / AWS env vars (take precedence over S3_* equivalents)
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
# AWS_ACCESS_KEY_ID=tid_...
# AWS_SECRET_ACCESS_KEY=tsec_...
# AWS_REGION=auto
# BUCKET_NAME=your-bucket

# ── Server ────────────────────────────────────────────
# SERVER_PORT or PORT (SERVER_PORT takes precedence)
# PORT=7433
# SERVER_PORT=7433
# SERVER_HOST or HOST (SERVER_HOST takes precedence)
# HOST=127.0.0.1
# SERVER_HOST=127.0.0.1
# AGENT_FS_RATE_LIMIT=3000

# ── Embeddings ────────────────────────────────────────
# Provider: "local", "openai", or "gemini"
# EMBEDDING_PROVIDER=openai
# When EMBEDDING_PROVIDER names another provider than config.json, agent-fs does not use
# the model and API key from config.json. EMBEDDING_MODEL and EMBEDDING_API_KEY still apply.
# Fresh local indexes use embeddinggemma-2 when transformers 4.3.1 loads.
# Otherwise, they use nomic-embed-text-v1.5. Existing nomic indexes keep nomic.
# EMBEDDING_MODEL overrides this choice.
# OpenAI and Gemini ignore EMBEDDING_MODEL.
# EMBEDDING_MODEL=embeddinggemma-2
# EMBEDDING_API_KEY=sk-...

# Raw uploads / HTTP request bodies, in bytes (default 50 MiB).
# Positive integer only; invalid values fall back to 52428800. Restart the daemon.
# Example: 100 MiB. JSON writes remain capped at 10 MiB.
# FUSE still has a 64 MiB encoded IPC frame ceiling; use HTTP for larger files.
# AGENT_FS_MAX_UPLOAD_BYTES=104857600
