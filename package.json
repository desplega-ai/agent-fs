{
  "name": "agent-fs",
  "version": "0.18.7",
  "packageManager": "bun@1.4.4",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test packages/*/src/ live/src/lib/",
    "test:coverage": "bun test --coverage packages/*/src/ live/src/lib/",
    "build": "cd packages/cli && bun run build:npm",
    "install-local": "bun run build && cd packages/cli && bun link",
    "uninstall-local": "bun remove -g @desplega.ai/agent-fs && rm -f ~/.bun/bin/agent-fs",
    "deploy:fly": "fly deploy -a agent-fs-taras"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@napi-rs/canvas": "1.0.11"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.3-r.3",
    "bun-types": "^1.4.0",
    "msgpackr": "^1",
    "typescript": "^5.7.0",
    "yaml": "^2.8.2",
    "zod-to-json-schema": "^3.25.1"
  },
  "overrides": {
    "@kreuzberg/tree-sitter-language-pack": "npm:empty-npm-package@1.0.0"
  }
}
